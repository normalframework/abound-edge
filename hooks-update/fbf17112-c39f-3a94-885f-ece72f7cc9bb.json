{
  "name": "publish-data",
  "entryPoint": "/publish-data.js",
  "points": {
    "query": {
      "field": {
        "property": "siteRef",
        "text": "MTN1"
      }
    },
    "groups": {
      "keys": [
        "siteRef"
      ]
    }
  },
  "schedule": {
    "rrule": "DTSTART:20260101T000000Z\nRRULE:FREQ=MINUTELY;INTERVAL=15"
  },
  "mode": "MODE_SCHEDULED",
  "invokeTimeout": "300s",
  "runtimeConfig": {
    "memoryLimit": 512,
    "maxRequestsPerLifetime": 1000,
    "maxInstances": 1
  }
}
